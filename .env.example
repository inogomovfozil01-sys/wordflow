# ==========================================
# WordFlow Environment Configuration Example
# ==========================================

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/wordflow?schema=public"
# DIRECT_URL is used by Prisma for migrations if using a connection pooler (e.g., Supabase / Neon)
DIRECT_URL="postgresql://postgres:password@localhost:5432/wordflow?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="wordflow-super-secure-production-auth-secret-key-32chars"

# Google Gemini AI API Key (from https://aistudio.google.com)
GEMINI_API_KEY=""

# Optional: Google OAuth Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
